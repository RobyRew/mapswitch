{
  "name": "mapswitch",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Universal map link redirector — open any location in your preferred maps app",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 5176",
    "build": "npm run check && astro build",
    "preview": "node ./server.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ./scripts/migrate.mjs",
    "icons": "node ./scripts/gen-icons.mjs",
    "astro": "astro",
    "check": "astro sync && node node_modules/typescript-7/bin/tsc --noEmit && node scripts/astro-check.mjs",
    "lint": "eslint .",
    "typecheck": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@astrojs/react": "^7.1.7",
    "@logto/node": "^3.1.11",
    "astro": "^7.4.10",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "es-module-lexer": "^2.3.2",
    "nanoid": "^5.1.16",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.17.3",
    "@eslint/js": "^9.39.5",
    "@robyrew/web-config": "github:RobyRew/web-config#v0.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "jose": "^6.2.17",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26"
  }
}
