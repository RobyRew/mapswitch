---
export const prerender = true;
import { LOCALES, isLocale, type Locale, t } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : 'en';
---

<BaseLayout locale={locale} title={t(locale, 'privacy.title')}>
  <section class="flex flex-col gap-5">
    <h1 class="text-gradient text-3xl font-bold tracking-tight sm:text-4xl">{t(locale, 'privacy.title')}</h1>

    <div class="panel flex flex-col gap-2 p-6">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-text">
        <span aria-hidden="true">🕶️</span>{t(locale, 'privacy.anonymousTitle')}
      </h2>
      <p class="leading-relaxed text-text-2">{t(locale, 'privacy.anonymousBody')}</p>
    </div>

    <div class="panel flex flex-col gap-2 p-6">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-text">
        <span aria-hidden="true">🔐</span>{t(locale, 'privacy.accountTitle')}
      </h2>
      <p class="leading-relaxed text-text-2">{t(locale, 'privacy.accountBody')}</p>
    </div>
  </section>
</BaseLayout>
