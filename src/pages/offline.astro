---
// Static fallback shown by the service worker when a navigation fails offline.
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout locale="en" title="Offline">
  <section class="rw-card mx-auto flex max-w-md flex-col items-center gap-4 p-10 text-center sm:mt-8">
    <span class="text-5xl">📡</span>
    <h1 class="text-2xl font-bold tracking-tight text-text">You're offline</h1>
    <p class="max-w-sm text-text-2">
      MapSwitch needs a connection to expand and resolve map links. Reconnect and try again.
    </p>
    <a href="/" class="rw-btn rw-btn--primary">Retry</a>
  </section>
</BaseLayout>
