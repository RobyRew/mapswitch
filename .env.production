# Committed on purpose — PUBLIC_* vars are baked into the shipped HTML by Astro,
# so these are visible to every visitor and are not secrets. Keeping them here
# rather than in Dokploy's build-args UI is deliberate: .env is gitignored, so a
# container build saw no website id and BaseLayout's guard silently emitted no
# script at all. Analytics recorded nothing from 2026-06-26 until 2026-09-04.
#
# Forks: data-domains pins reporting to this hostname, so a deployment anywhere
# else sends NOTHING. Change the id and domain to point at your own Umami.
PUBLIC_UMAMI_SCRIPT_URL=https://stats.cosmincalin.es/script.js
PUBLIC_UMAMI_WEBSITE_ID=ff4eff5b-ff09-4e95-bddb-12f1d92f5e4a
PUBLIC_UMAMI_DOMAINS=maps.robyrew.com
